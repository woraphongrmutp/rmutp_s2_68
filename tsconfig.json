{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,      // ช่วยให้ import crypto และโมดูลอื่นง่ายขึ้น
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "node_modules",
    ".env",
    "db.yml"
  ]
}
